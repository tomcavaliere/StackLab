---
interface Props {
  current: 'type' | 'metier';
}
const { current } = Astro.props;
const tabs = [
  ['type', '/fiches', 'Par type'],
  ['metier', '/fiches/metiers', 'Par métier'],
];
---

<div class="flex gap-1 border-b border-slate-200">
  {
    tabs.map(([key, href, label]) => (
      <a
        href={href}
        class:list={[
          '-mb-px border-b-2 px-4 py-2 text-sm',
          key === current ? 'border-blue-600 font-medium text-blue-700' : 'border-transparent text-slate-600 hover:text-blue-700',
        ]}
      >
        {label}
      </a>
    ))
  }
</div>
