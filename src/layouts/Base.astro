---
import '../styles/global.css';

interface Props {
  title: string;
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['/fiches', 'Fiches'],
  ['/quiz', 'Quiz'],
  ['/jouer', 'Jouer'],
  ['/entreprises', 'Entreprises'],
  ['/progression', 'Progression'],
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>{title} · StackLab</title>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <nav class="flex gap-6 border-b border-slate-200 bg-white px-8 py-3">
      <a href="/" class="font-semibold">StackLab</a>
      {
        nav.map(([href, label]) => (
          <a href={href} class:list={['hover:text-blue-700', path.startsWith(href) && 'text-blue-700 font-medium']}>
            {label}
          </a>
        ))
      }
      <a id="progress-widget" href="/progression" class="ml-auto text-sm text-slate-600 hover:text-blue-700"></a>
    </nav>
    <main class:list={['mx-auto px-8 py-6', wide ? 'max-w-[1600px]' : 'max-w-6xl']}>
      <slot />
    </main>
  </body>
</html>

<script>
  // Widget de progression, rafraîchi au chargement et quand le quiz enregistre une session.
  function refresh() {
    fetch('/api/progress')
      .then((r) => r.json())
      .then(({ xp, level, streak }: { xp: number; level: { number: number; name: string }; streak: { current: number; today: boolean } }) => {
        const widget = document.getElementById('progress-widget')!;
        widget.textContent = `Niv. ${level.number} ${level.name} · ${xp} XP · 🔥 ${streak.current}`;
        widget.title = streak.today ? 'Série du jour validée' : 'Joue aujourd’hui pour faire vivre ta série';
      });
  }
  refresh();
  window.addEventListener('stacklab:progress', refresh);
</script>
