---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>{title} · StackLab</title>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <nav class="flex gap-6 border-b border-slate-200 bg-white px-8 py-3">
      <a href="/" class="font-semibold">StackLab</a>
    </nav>
    <main class="mx-auto max-w-6xl px-8 py-6">
      <slot />
    </main>
  </body>
</html>
