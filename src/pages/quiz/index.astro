---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SESSION_SIZE } from '../../lib/rewards';
import { KINDS } from '../../lib/taxonomy';
import { loadLearning } from '../../lib/progress';
import { isOpen, stepOf } from '../../lib/path';

// Ordre du parcours ; un quiz verrouillé reste listé, grisé (sa page explique comment l'ouvrir).
const { path } = await loadLearning();
const order = path.units.flatMap((u) => u.steps.map((s) => s.id));
const themes = (await getCollection('quiz')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const locked = (kind: 'lesson' | 'theme', id: string) => !isOpen(stepOf(path, kind, id));
const techs = await getCollection('techs');
const quizSize = new Map((await getCollection('techQuiz')).map((q) => [q.id, q.data.questions.length]));
// Quiz de techno regroupés par kind, dans l'ordre de la taxonomie.
const groups = Object.entries(KINDS)
  .map(([kind, label]) => ({
    label,
    techs: techs
      .filter((t) => t.data.kind === kind && quizSize.has(t.id))
      .sort((a, b) => a.data.name.localeCompare(b.data.name, 'fr')),
  }))
  .filter((g) => g.techs.length > 0);
---

<Base title="Quiz">
  <h1 class="text-2xl font-bold">Quiz</h1>
  <p class="mt-1 text-slate-600">
    {SESSION_SIZE} questions par session. Les questions ratées reviennent en premier ; une question est maîtrisée après 2 bonnes
    réponses d'affilée.
  </p>

  <h2 class="mt-6 text-xl font-semibold">Par thème</h2>
  <p class="mt-1 text-sm text-slate-600">2 technos à chaque question, une seule est la bonne : apprendre à les départager.</p>
  <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      themes.map((t) => (
        <li data-theme={t.id}>
          <a href={`/quiz/${t.id}`} class:list={['flex h-full flex-col gap-2 rounded border border-slate-200 bg-white p-5 hover:border-slate-400', locked('theme', t.id) && 'opacity-50']}>
            <span class="flex flex-wrap items-baseline justify-between gap-x-3">
              <span class="text-lg font-semibold">{locked('theme', t.id) && '🔒 '}{t.data.title}</span>
              <span class="shrink-0 text-sm text-slate-500">{t.data.questions.length} questions</span>
            </span>
            <span class="text-sm text-slate-600">{t.data.description}</span>
            <span class="mt-auto h-2 overflow-hidden rounded-full bg-slate-200">
              <span data-bar class="block h-full w-0 rounded-full bg-emerald-500 transition-all duration-700" />
            </span>
            <span data-mastery class="text-sm text-slate-500">Jamais joué</span>
          </a>
        </li>
      ))
    }
  </ul>

  <h2 class="mt-10 text-xl font-semibold">Par techno</h2>
  <p class="mt-1 text-sm text-slate-600">
    Un quiz par fiche pour maîtriser chaque techno : son rôle, ses mécanismes, quand l'utiliser et quand l'éviter.
    <span id="techs-summary" class="font-medium"></span>
  </p>
  {
    groups.map((g) => (
      <section class="mt-5">
        <h3 class="text-xs font-semibold tracking-wide text-slate-500 uppercase">{g.label}</h3>
        <ul class="mt-2 grid grid-cols-2 gap-3 md:grid-cols-4">
          {g.techs.map((t) => (
            <li data-tech={t.id}>
              <a
                href={`/quiz/techno/${t.id}`}
                class:list={['flex flex-col gap-1.5 rounded border border-slate-200 bg-white px-3 py-2 hover:border-slate-400', locked('lesson', t.id) && 'opacity-50']}
              >
                <span class="flex flex-wrap items-baseline justify-between gap-x-2">
                  <span class="font-medium">{locked('lesson', t.id) && '🔒 '}{t.data.name}</span>
                  <span data-mastery class="shrink-0 text-xs text-slate-500">
                    {quizSize.get(t.id)} questions
                  </span>
                </span>
                <span class="h-1.5 overflow-hidden rounded-full bg-slate-200">
                  <span data-bar class="block h-full w-0 rounded-full bg-emerald-500 transition-all duration-700" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<script>
  type Mastery = { mastered: number; total: number; sessions: number };

  function fill(li: HTMLElement, m: Mastery | undefined, text: (m: Mastery) => string) {
    if (!m?.sessions) return;
    li.querySelector<HTMLElement>('[data-bar]')!.style.width = `${(100 * m.mastered) / m.total}%`;
    li.querySelector('[data-mastery]')!.textContent = text(m);
  }

  fetch('/api/progress')
    .then((r) => r.json())
    .then(({ themes, techs }: { themes: Record<string, Mastery>; techs: Record<string, Mastery> }) => {
      for (const li of document.querySelectorAll<HTMLElement>('[data-theme]')) {
        fill(li, themes[li.dataset.theme!], (t) => `${t.mastered} / ${t.total} maîtrisées · ${t.sessions} session${t.sessions > 1 ? 's' : ''}`);
      }
      for (const li of document.querySelectorAll<HTMLElement>('[data-tech]')) {
        fill(li, techs[li.dataset.tech!], (t) => (t.mastered === t.total ? '✓ maîtrisée' : `${t.mastered} / ${t.total}`));
      }
      const all = Object.values(techs);
      const mastered = all.filter((t) => t.total > 0 && t.mastered === t.total).length;
      const played = all.filter((t) => t.sessions > 0).length;
      if (played) document.getElementById('techs-summary')!.textContent = `${mastered} / ${all.length} maîtrisées, ${played} jouées.`;
    });
</script>
