---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isOld } from '../../lib/sources';
import { loadLearning } from '../../lib/progress';
import { companyOpen } from '../../lib/path';
import { url } from '../../lib/url';

const { path } = await loadLearning();

const companies = (await getCollection('companies')).sort((a, b) => a.data.company.localeCompare(b.data.company, 'fr'));
const entries = (c: (typeof companies)[number]) => Object.values(c.data.stack).flat();
---

<Base title="Entreprises">
  <h1 class="text-2xl font-bold">Stacks d'entreprises</h1>
  <p class="mt-1 text-slate-600">Des stacks réelles, chaque techno avec sa source, sa date et un niveau de confiance.</p>
  <ul class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      companies.map((c) => {
        const all = entries(c);
        const old = all.filter((e) => isOld(e!.sourceDate)).length;
        return (
          <li>
            <a href={url(`/entreprises/${c.id}`)} class:list={['flex h-full flex-col gap-2 rounded border border-slate-200 bg-white p-5 hover:border-slate-400', !companyOpen(path, c.data.scenario?.id) && 'opacity-50']}>
              <span class="text-lg font-semibold">{!companyOpen(path, c.data.scenario?.id) && '🔒 '}{c.data.company}</span>
              <span class="text-sm text-slate-500">{c.data.product}</span>
              <span class="text-slate-700">{c.data.need}</span>
              <span class="text-sm text-slate-500">
                {all.length} technos sourcées
                {old > 0 && <span class="ml-1 rounded bg-amber-100 px-1 text-amber-800">⚠ {old} source{old > 1 ? 's' : ''} de plus de 3 ans</span>}
              </span>
              {c.data.scenario && <span class="text-sm font-medium text-violet-700">Mode « devine la stack » disponible</span>}
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>
