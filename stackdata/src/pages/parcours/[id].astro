---
// Un parcours : ses unités et leurs étapes, dans l'ordre. Le statut affiché est celui de l'étape dans ce parcours ;
// les liens suivent l'étape fusionnée (un quiz en cours dans un autre parcours ouvert reste jouable d'ici).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { describeStep, loadLearning } from '../../lib/progress';
import { companyOpen, isOpen, stepOf, type Step } from '../../lib/path';
import { PARCOURS_KINDS } from '../../lib/taxonomy';
import { url } from '../../lib/url';

const { path } = await loadLearning();
const p = path.parcours.find((c) => c.id === Astro.params.id);
if (!p) return new Response('Introuvable', { status: 404 });
const titleOf = new Map(path.parcours.map((c) => [c.id, c.title]));
const next = p.current ? await describeStep(p.current) : null;
const followed = path.followed === p.id;

const [techs, themes, scenarios, companies] = await Promise.all([
  getCollection('techs'),
  getCollection('quiz'),
  getCollection('scenarios'),
  getCollection('companies'),
]);
const techName = new Map(techs.map((t) => [t.id, t.data.name]));
const themeTitle = new Map(themes.map((t) => [t.id, t.data.title]));
const scenarioTitle = new Map(scenarios.map((s) => [s.id, s.data.title]));
const companyOf = (scenarioId: string) => companies.find((c) => c.data.scenario?.id === scenarioId);

const isCurrent = (s: Step) => p.current?.kind === s.kind && p.current.id === s.id;
const open = (s: Step) => isOpen(stepOf(path, s.kind, s.id));
const icon = { done: '✓', current: '▶', locked: '🔒' };
const iconStyle = {
  done: 'bg-emerald-500 text-white',
  current: 'bg-blue-600 text-white',
  locked: 'bg-slate-200 text-slate-400 text-xs',
};
const link = 'text-blue-700 underline';
---

<Base title={p.title}>
  <p class="text-sm text-slate-500"><a href={url('/')} class="hover:text-blue-700">Parcours</a> · {PARCOURS_KINDS[p.kind]}</p>
  <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4">
    <h1 class="text-2xl font-bold">{p.title}</h1>
    <span class="text-sm text-slate-500">{p.done} / {p.total} étapes</span>
  </div>
  <p class="mt-1 max-w-3xl text-slate-600">{p.intro}</p>
  <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-200">
    <div class="h-full rounded-full bg-emerald-500" style={`width: ${(100 * p.done) / p.total}%`}></div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    {
      followed ? (
        <span class="rounded bg-blue-50 px-3 py-1.5 text-sm font-medium text-blue-800">★ Parcours suivi</span>
      ) : (
        p.status !== 'done' && (
          <button id="follow" data-id={p.id} class="rounded bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700">
            Suivre ce parcours
          </button>
        )
      )
    }
    {next && p.unlocked && <a href={next.href} class={`text-sm ${link}`}>Prochaine étape : {next.label}</a>}
    {p.role && <a href={url(`/fiches/metiers?m=${p.role}`)} class={`text-sm ${link}`}>La pile du métier</a>}
  </div>
  {
    !p.unlocked && (
      <p class="mt-4 rounded border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        🔒 Ce parcours s'ouvre après {p.waitingFor.map((id) => `« ${titleOf.get(id)} »`).join(', ')}. Les étapes déjà faites restent faites.
      </p>
    )
  }

  <ol class="mt-6 space-y-3">
    {
      p.units.map((u, i) => (
        <li>
          <details open={u.status === 'current'} class:list={['group rounded border bg-white', u.status === 'current' ? 'border-blue-300' : 'border-slate-200']}>
            <summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
              <span class:list={['flex h-8 w-8 shrink-0 items-center justify-center rounded-full font-semibold', iconStyle[u.status]]}>
                {u.status === 'done' ? '✓' : i + 1}
              </span>
              <span class:list={['font-semibold', u.status === 'locked' && 'text-slate-400']}>{u.title}</span>
              <span class="ml-auto text-sm text-slate-500">
                {u.done} / {u.steps.length}
              </span>
              <span class="basis-full pl-11 text-sm text-slate-500">{u.intro}</span>
            </summary>
            <ul class="border-t border-slate-100 px-4 py-2">
              {u.steps.map((s) => {
                const company = s.kind === 'scenario' ? companyOf(s.id) : undefined;
                return (
                  <li class:list={['flex flex-wrap items-center gap-x-3 gap-y-1 py-1.5', isCurrent(s) && 'font-medium']}>
                    <span class:list={['flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-sm', iconStyle[s.status]]}>{icon[s.status]}</span>
                    {s.kind === 'lesson' && (
                      <>
                        <span class:list={[s.status === 'locked' && 'text-slate-400']}>{techName.get(s.id)}</span>
                        <span class="ml-auto flex gap-3 text-sm">
                          <a href={url(`/fiches/${s.id}`)} class:list={[s.status === 'locked' ? 'text-slate-400 hover:text-blue-700' : link]}>
                            {s.viewed ? '✓ fiche' : 'fiche'}
                          </a>
                          {open(s) ? <a href={url(`/quiz/techno/${s.id}`)} class={link}>quiz</a> : <span class="text-slate-400">quiz</span>}
                        </span>
                      </>
                    )}
                    {s.kind === 'theme' && (
                      <>
                        <span class:list={[s.status === 'locked' && 'text-slate-400']}>Quiz du thème « {themeTitle.get(s.id)} »</span>
                        {open(s) && <a href={url(`/quiz/${s.id}`)} class={`ml-auto text-sm ${link}`}>jouer</a>}
                      </>
                    )}
                    {s.kind === 'scenario' && (
                      <>
                        <span class:list={[s.status === 'locked' && 'text-slate-400']}>Scénario : {scenarioTitle.get(s.id)}</span>
                        <span class="ml-auto flex gap-3 text-sm">
                          {open(s) && <a href={url(`/jouer/${s.id}`)} class={link}>jouer</a>}
                          {company && companyOpen(path, s.id) && (
                            <a href={url(`/entreprises/${company.id}`)} class="text-violet-700 underline">stack de {company.data.company}</a>
                          )}
                        </span>
                      </>
                    )}
                  </li>
                );
              })}
            </ul>
          </details>
        </li>
      ))
    }
  </ol>
</Base>

<script>
  import { url } from '../../lib/url';
  document.getElementById('follow')?.addEventListener('click', async (e) => {
    const button = e.currentTarget as HTMLButtonElement;
    button.disabled = true;
    const res = await fetch(url('/api/parcours'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: button.dataset.id }),
    });
    if (res.ok) location.reload();
    else button.disabled = false;
  });
</script>
