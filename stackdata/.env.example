# Copier en .env (ignoré par git). Toutes les variables sont optionnelles en local.
# Turso : sans URL, la progression va dans le fichier local data/stackdata.db.
# En ligne, StackData et StackPolitique partagent la même base Turso (tables de StackPolitique préfixées politique_).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Mot de passe (Basic Auth), le même pour les deux apps et le portail. Vide : pas de mot de passe.
APP_PASSWORD=
