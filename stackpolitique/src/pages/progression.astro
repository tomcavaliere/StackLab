---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getProgress, loadHistory } from '../lib/progress';
import { ficheOfQuiz, isCorrect, sessionXp } from '../lib/rewards';
import { loadLearning } from '../lib/progress';
import { REVIEW } from '../lib/review';
import { allSteps } from '../lib/path';

const progress = await getProgress();
const history = await loadHistory();
const { path, reviews } = await loadLearning(history);
// Étapes distinctes : une étape partagée par plusieurs parcours ne compte qu'une fois.
const distinctSteps = [...new Map(allSteps(path).map((s) => [`${s.kind}:${s.id}`, s.status === 'done'])).values()];
const stepsDone = distinctSteps.filter(Boolean).length;
const parcoursDone = path.parcours.filter((p) => p.status === 'done').length;
const nextParcours = path.next && path.parcours.find((p) => p.id === path.next!.parcours);
const [themes, fiches, ficheQuizzes] = await Promise.all([getCollection('quiz'), getCollection('fiches'), getCollection('ficheQuiz')]);
const themeTitle = new Map(themes.map((t) => [t.id, t.data.title]));
const ficheName = new Map(fiches.map((f) => [f.id, f.data.name]));

const { xp, xpBySource, level, streak } = progress;
const levelWidth = level.next ? (100 * (xp - level.floor)) / (level.next - level.floor) : 100;
const date = (iso: string) => new Date(iso).toLocaleString('fr-FR', { dateStyle: 'medium', timeStyle: 'short' });
const unlockedCount = progress.badges.filter((b) => b.unlockedAt).length;

const ficheMastery = ficheQuizzes
  .map((q) => ({ id: q.id, name: ficheName.get(q.id) ?? q.id, ...progress.fiches[q.id] }))
  .sort((a, b) => a.name.localeCompare(b.name, 'fr'));
const fichesMastered = ficheMastery.filter((t) => t.total > 0 && t.mastered === t.total).length;
const fichesPlayed = ficheMastery.filter((t) => t.sessions > 0).length;

function quizLink(themeId: string) {
  const ficheId = ficheOfQuiz(themeId);
  if (ficheId) return { href: `/quiz/fiche/${ficheId}`, label: `Quiz fiche · ${ficheName.get(ficheId) ?? ficheId}` };
  return { href: `/quiz/${themeId}`, label: `Quiz · ${themeTitle.get(themeId) ?? themeId}` };
}

const activity = history.quizSessions
  .map((s) => ({
    at: s.playedAt,
    ...quizLink(s.themeId),
    result: `${s.answers.filter(isCorrect).length} / ${s.answers.length}`,
    detail: `+${sessionXp(s.answers)} XP`,
  }))
  .sort((a, b) => b.at.localeCompare(a.at))
  .slice(0, 15);
const card = 'rounded border border-slate-200 bg-white px-5 py-4';
---

<Base title="Progression">
  <h1 class="text-2xl font-bold">Progression</h1>

  <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-[2fr_1fr]">
    <section class={card}>
      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
        <span class="text-xl font-bold">Niv. {level.number} · {level.name}</span>
        <span class="text-slate-500">{level.next ? `${xp} / ${level.next} XP` : `${xp} XP · niveau max`}</span>
      </div>
      <div class="mt-2 h-3 overflow-hidden rounded-full bg-slate-200">
        <div class="h-full rounded-full bg-blue-600" style={`width: ${levelWidth}%`}></div>
      </div>
      <p class="mt-2 text-sm text-slate-500">
        Quiz {xpBySource.quiz} XP · Fiches {xpBySource.fiches} XP
        (une fois par fiche lue)
      </p>
    </section>
    <section class={card}>
      <div class="text-xl font-bold">🔥 {streak.current} jour{streak.current > 1 ? 's' : ''}</div>
      <p class="text-sm text-slate-500">Record : {streak.best} jour{streak.best > 1 ? 's' : ''}</p>
      {
        !streak.today && (
          <p class="mt-2 text-sm font-medium text-orange-700">
            {streak.current > 0 ? 'Joue aujourd’hui pour garder ta série.' : 'Un quiz aujourd’hui lance une série.'}
          </p>
        )
      }
    </section>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    <a href="/" class={`${card} hover:border-slate-400`}>
      <h2 class="text-lg font-semibold">Parcours</h2>
      <p class="mt-1 text-sm text-slate-600">
        {stepsDone} / {distinctSteps.length} étapes · {parcoursDone} / {path.parcours.length} parcours terminés
        {nextParcours && ` · en cours : ${nextParcours.title}`}
      </p>
      <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-200">
        <div class="h-full rounded-full bg-emerald-500" style={`width: ${(100 * stepsDone) / distinctSteps.length}%`}></div>
      </div>
    </a>
    <a href="/revisions" class={`${card} hover:border-slate-400`}>
      <h2 class="text-lg font-semibold">Révisions</h2>
      <p class="mt-1 text-sm text-slate-600">
        {reviews.due} à revoir aujourd'hui · {reviews.tracked} questions en révision, dont {reviews.mature} solidement retenues
        (intervalle d'au moins {REVIEW.mature} jours){reviews.fresh > 0 && ` · ${reviews.fresh} à découvrir en renforcement`}
      </p>
    </a>
  </div>

  <section class={`${card} mt-4`}>
    <h2 class="text-lg font-semibold">Badges · {unlockedCount} / {progress.badges.length}</h2>
    <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
      {
        progress.badges.map((b) => (
          <li
            class:list={[
              'rounded border px-3 py-2',
              b.unlockedAt ? 'border-violet-200 bg-violet-50' : 'border-slate-200 bg-slate-50 opacity-50 grayscale',
            ]}
          >
            <span class="text-2xl">{b.icon}</span>
            <span class="block font-medium">{b.label}</span>
            <span class="block text-xs text-slate-600">{b.description}</span>
            {b.unlockedAt && <span class="block text-xs text-violet-700">{date(b.unlockedAt)}</span>}
          </li>
        ))
      }
    </ul>
  </section>

  <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    <section class={card}>
      <h2 class="text-lg font-semibold">Maîtrise par thème</h2>
      <ul class="mt-3 space-y-3">
        {
          themes.map((t) => {
            const p = progress.themes[t.id];
            return (
              <li>
                <a href={`/quiz/${t.id}`} class="flex items-baseline justify-between text-sm hover:text-blue-700">
                  <span class="font-medium">{t.data.title}</span>
                  <span class="text-slate-500">
                    {p.mastered} / {p.total}
                  </span>
                </a>
                <div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-200">
                  <div class="h-full rounded-full bg-emerald-500" style={`width: ${(100 * p.mastered) / p.total}%`} />
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>
    <section class={card}>
      <h2 class="text-lg font-semibold">Ce que tu confonds</h2>
      {
        progress.confusions.length === 0 ? (
          <p class="mt-3 text-sm text-slate-500">Aucune confusion dans les quiz par thème pour l'instant.</p>
        ) : (
          <ul class="mt-3 space-y-1.5 text-sm">
            {progress.confusions.map(({ fiches: pair, count }) => (
              <li class="flex items-baseline justify-between">
                <span>
                  {pair.map((id, i) => (
                    <>
                      {i > 0 && ' ↔ '}
                      <a href={`/fiches/${id}`} class="text-blue-700 underline">
                        {ficheName.get(id) ?? id}
                      </a>
                    </>
                  ))}
                </span>
                <span class="text-slate-500">
                  {count} fois
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>

  <section class={`${card} mt-4`}>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
      <h2 class="text-lg font-semibold">Maîtrise par fiche</h2>
      <span class="text-sm text-slate-500">{fichesMastered} / {ficheMastery.length} maîtrisées · {fichesPlayed} jouées</span>
    </div>
    <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 md:grid-cols-4">
      {
        ficheMastery.map((t) => (
          <li class:list={[t.sessions === 0 && 'opacity-50']}>
            <a href={`/quiz/fiche/${t.id}`} class="flex items-baseline justify-between text-sm hover:text-blue-700">
              <span class="font-medium">{t.name}</span>
              <span class="text-slate-500">{t.mastered === t.total ? '✓' : `${t.mastered} / ${t.total}`}</span>
            </a>
            <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-200">
              <div class="h-full rounded-full bg-emerald-500" style={`width: ${(100 * t.mastered) / t.total}%`} />
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class={`${card} mt-4`}>
    <h2 class="text-lg font-semibold">Dernières activités</h2>
    {
      activity.length === 0 ? (
        <p class="mt-3 text-sm text-slate-500">Rien encore : lance un quiz.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="mt-2 w-full text-sm">
            <tbody>
              {activity.map((a) => (
                <tr class="border-t border-slate-100">
                  <td class="py-1.5 pr-3 whitespace-nowrap text-slate-500">{date(a.at)}</td>
                  <td class="py-1.5 pr-3">
                    <a href={a.href} class="hover:text-blue-700">
                      {a.label}
                    </a>
                  </td>
                  <td class="py-1.5 pr-3 text-right font-medium whitespace-nowrap">{a.result}</td>
                  <td class="py-1.5 text-right whitespace-nowrap text-blue-700">{a.detail}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</Base>
