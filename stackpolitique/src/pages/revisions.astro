---
// Révisions du jour : questions des étapes faites arrivées à échéance (src/lib/review.ts), tous quiz mélangés.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Quiz, { type QuizQuestion } from '../components/quiz/Quiz';
import { loadLearning } from '../lib/progress';
import { ficheOfQuiz, ficheQuizId } from '../lib/rewards';
import { REVIEW } from '../lib/review';
import { url } from '../lib/url';

const { reviews } = await loadLearning();
const [fiches, themes, ficheQuizzes] = await Promise.all([getCollection('fiches'), getCollection('quiz'), getCollection('ficheQuiz')]);

// Les questions de chaque quiz, au format de l'îlot (ids en clair), par id de session.
const byQuiz = new Map<string, Map<string, QuizQuestion>>([
  ...themes.map((t): [string, Map<string, QuizQuestion>] => [
    t.id,
    new Map(t.data.questions.map(({ decoy, ...q }) => [q.id, { ...q, answer: q.answer.id, decoys: [decoy.id], quizId: t.id }])),
  ]),
  ...ficheQuizzes.map((t): [string, Map<string, QuizQuestion>] => [
    ficheQuizId(t.id),
    new Map(t.data.questions.map((q) => [q.id, { ...q, quizId: ficheQuizId(t.id), ficheId: t.id }])),
  ]),
]);
const questions = reviews.items.flatMap((i) => byQuiz.get(i.quizId)?.get(i.questionId) ?? []);
const ficheNames = Object.fromEntries(fiches.map((f) => [f.id, f.data.name]));
const quizCount = new Set(reviews.items.map((i) => ficheOfQuiz(i.quizId) ?? i.quizId)).size;
const day = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
---

<Base title="Révisions">
  <a href={url('/')} class="text-sm text-slate-500 hover:text-blue-700">← Parcours</a>
  <h1 class="mt-2 text-2xl font-bold">Révisions du jour</h1>
  {
    questions.length > 0 ? (
      <>
        <p class="mt-1 mb-6 max-w-3xl text-slate-600">
          {questions.length} question{questions.length > 1 ? 's' : ''} déjà vue{questions.length > 1 ? 's' : ''}, de {quizCount} quiz
          {reviews.due > questions.length && ` (${reviews.due} dues en tout, ${REVIEW.limit} par session)`}. Une bonne réponse espace la
          prochaine révision (1, 3, 8, 20 jours…), une erreur la fait revenir dès aujourd'hui.
        </p>
        <Quiz client:only="react" review questions={questions} ficheNames={ficheNames} />
      </>
    ) : (
      <div class="mt-4 max-w-xl rounded border border-slate-200 bg-white px-5 py-5">
        <p class="font-semibold">Rien à réviser pour l'instant.</p>
        <p class="mt-1 text-slate-600">
          {reviews.next
            ? `Prochaine révision : ${day(reviews.next)}.`
            : 'Les questions des étapes validées viendront ici, de plus en plus espacées.'}{' '}
          {reviews.tracked > 0 && `${reviews.tracked} questions en révision, dont ${reviews.mature} solidement retenues (intervalle d'au moins ${REVIEW.mature} jours).`}
        </p>
        {reviews.fresh > 0 && (
          <p class="mt-2 text-slate-600">
            {reviews.fresh} questions jamais vues des étapes validées t'attendent dans{' '}
            <a href={url('/renforcement')} class="text-blue-700 underline">Renforcement</a> : une fois vues, elles entrent dans les révisions.
          </p>
        )}
        <a href={url('/')} class="mt-4 inline-block rounded bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700">Continuer le parcours →</a>
      </div>
    )
  }
</Base>
