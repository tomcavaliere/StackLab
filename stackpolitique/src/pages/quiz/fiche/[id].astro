---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Quiz from '../../../components/quiz/Quiz';
import { ficheQuizId } from '../../../lib/rewards';
import { loadLearning } from '../../../lib/progress';
import { isOpen, stepOf } from '../../../lib/path';
import { unseen } from '../../../lib/review';
import { url } from '../../../lib/url';

const quiz = await getEntry('ficheQuiz', Astro.params.id!);
if (!quiz) return new Response('Introuvable', { status: 404 });
// Vérifié au build par scripts/check-content.mjs ; en dev, une erreur explicite plutôt qu'une page cassée.
const fiche = await getEntry('fiches', quiz.id);
if (!fiche) throw new Error(`src/content/quiz-fiche/${quiz.id}.md : aucune fiche src/content/fiches/${quiz.id}.md`);
const { path, states } = await loadLearning();
// Renforcement (?renforcement) : les questions jamais vues d'une leçon déjà validée.
const reinforce = Astro.url.searchParams.has('renforcement');
const step = stepOf(path, 'lesson', fiche.id);
if (reinforce && step?.status !== 'done') return Astro.redirect(url('/renforcement'));
if (!isOpen(step)) return Astro.redirect(url(`/verrou?etape=lesson&id=${fiche.id}`));
const left = new Set(unseen(states, { id: ficheQuizId(fiche.id), questionIds: quiz.data.questions.map((q) => q.id) }));
const questions = reinforce ? quiz.data.questions.filter((q) => left.has(q.id)) : quiz.data.questions;
---

<Base title={`Quiz · ${fiche.data.name}`}>
  <a href={url(reinforce ? '/renforcement' : '/')} class="text-sm text-slate-500 hover:text-blue-700">
    ← {reinforce ? 'Renforcement' : 'Parcours'}
  </a>
  <h1 class="mt-2 text-2xl font-bold">{reinforce ? 'Renforcement' : 'Quiz'} {fiche.data.name}</h1>
  <p class="mt-1 mb-6 max-w-3xl text-slate-600">
    {reinforce ? `${questions.length} questions jamais vues sur ${quiz.data.questions.length}.` : fiche.data.summary}
    <a href={url(`/fiches/${fiche.id}`)} target="_blank" class="text-blue-700 underline">Relire la fiche ↗</a>
  </p>
  {
    questions.length > 0 ? (
      <Quiz
        client:only="react"
        themeId={ficheQuizId(fiche.id)}
        questions={questions}
        ficheNames={{ [fiche.id]: fiche.data.name }}
        ficheId={fiche.id}
        reinforce={reinforce}
      />
    ) : (
      <p class="rounded border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-800">
        ✓ Toutes les questions de ce quiz sont déjà vues : elles reviennent dans les révisions.
      </p>
    )
  }
</Base>
