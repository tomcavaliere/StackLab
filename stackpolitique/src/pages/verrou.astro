---
// Page affichée quand on ouvre une étape que le parcours n'a pas encore atteinte (les pages verrouillées redirigent ici).
// ?etape=lesson|theme&id=<id>
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { describeStep, loadLearning } from '../lib/progress';
import { placesOf, stepOf, type StepKind } from '../lib/path';
import { url } from '../lib/url';

const kind = Astro.url.searchParams.get('etape') ?? '';
const id = Astro.url.searchParams.get('id') ?? '';
const { path } = await loadLearning();
const next = await describeStep(path.next);
const titleOf = new Map(path.parcours.map((p) => [p.id, p.title]));

let title = 'Étape verrouillée';
let message = "Cette étape n'est pas encore ouverte.";
let action: { label: string; href: string } | null = next;

{
  const step = stepOf(path, kind as StepKind, id);
  const places = placesOf(path, kind as StepKind, id);
  const name = kind === 'lesson' ? (await getEntry('fiches', id))?.data.name : (await getEntry('quiz', id))?.data.title;
  title = kind === 'lesson' ? `Quiz ${name ?? id} : verrouillé` : `${name ?? id} : verrouillé`;
  if (step && step.status !== 'locked' && !step.viewed) {
    message = 'Lis la fiche avant de faire son quiz.';
    action = { label: `Lire la fiche ${name ?? id}`, href: url(`/fiches/${id}`) };
  } else if (places.length) {
    // Les parcours ouverts d'abord : l'étape s'y ouvrira en avançant ; sinon, il faut d'abord ouvrir le parcours.
    const where = places.map(({ parcours, unit }) => `« ${parcours.title} » (unité « ${unit.title} »)`).join(', ');
    const { parcours } = places[0];
    const of = places.length > 1 ? 'des parcours' : 'du parcours';
    message = parcours.unlocked
      ? `Cette étape fait partie ${of} ${where}. Elle s'ouvrira quand tu y arriveras : chaque étape validée ouvre la suivante.`
      : `Cette étape fait partie du parcours « ${parcours.title} » (unité « ${places[0].unit.title} »), qui s'ouvre après ${parcours.waitingFor.map((w) => `« ${titleOf.get(w)} »`).join(', ')}.`;
    if (parcours.unlocked) action = { label: `Ouvrir le parcours ${parcours.title}`, href: url(`/parcours/${parcours.id}`) };
  }
}
---

<Base title="Verrouillé">
  <div class="mx-auto mt-6 max-w-xl rounded border border-slate-200 bg-white px-5 py-6 text-center">
    <p class="text-4xl">🔒</p>
    <h1 class="mt-2 text-xl font-bold">{title}</h1>
    <p class="mt-2 text-slate-600">{message}</p>
    <div class="mt-5 flex flex-wrap justify-center gap-3">
      {
        action && (
          <a href={action.href} class="rounded bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700">
            {action.label} →
          </a>
        )
      }
      <a href={url('/')} class="rounded bg-slate-200 px-4 py-2 font-medium hover:bg-slate-300">Parcours</a>
    </div>
  </div>
</Base>
